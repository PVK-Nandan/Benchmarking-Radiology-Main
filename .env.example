OPENAI_API_KEY=sk-your-openai-key
DEFAULT_REPORT_PROVIDER=openai
OPENAI_JUDGE_MODEL=gpt-4.1-mini

# Optional Google login. Use the same OAuth web client ID for both values.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Used to sign local app sessions. Set a long random value in production.
AUTH_SECRET=replace-with-a-long-random-session-secret

# Optional admin override. Defaults in local code: admin@ai / 123456789.
ADMIN_EMAIL=admin@ai
ADMIN_PASSWORD=123456789

# Optional persistent storage for Vercel deployment.
# If these are not set, local VS Code runs save to ./data/report-tests.jsonl and ./data/uploads.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-server-only-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key
SUPABASE_BUCKET=monarcs-report-tests
